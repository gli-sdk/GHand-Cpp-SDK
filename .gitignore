# Build directories
/build/
/build*/
/cmake-build-*/
/out/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
install_manifest.txt

# Compiler and linker outputs
*.obj
*.o
*.pdb
*.ilk
*.exp
*.exe
*.dll
*.so
*.so.*
*.a
*.lib

# Keep SDK release dependencies under version control.
!deps/lib/**/*.dll
!deps/lib/**/*.so
!deps/lib/**/*.so.*
!deps/lib/**/*.a
!deps/lib/**/*.lib

# IDE and local agent state
.vscode/
.idea/
.claude/
.agents/
.codex/
.claudeignore

# Local packages and generated archives
*.zip
*.tar
*.tar.gz
*.tgz
